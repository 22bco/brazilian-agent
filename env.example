# ─────────────────────────────────────────────────────────────────────────
# Plantilla de configuración.
#   cp env.example .env      (¡ojo: el destino lleva punto -> .env!)
# Luego rellena .env con tus valores reales.
# El archivo .env NUNCA se sube a git (ver .gitignore).
# ─────────────────────────────────────────────────────────────────────────

# --- LLM ------------------------------------------------------------------
# Proveedor: "deepseek" (por defecto) u "openai". Intercambiable sin tocar código.
LLM_PROVIDER=deepseek

# API key del proveedor elegido. Para DeepSeek, ponla aquí:
DEEPSEEK_API_KEY=

# (opcional) si usas OpenAI en vez de DeepSeek:
# OPENAI_API_KEY=

# (opcional) overrides - normalmente NO hace falta tocarlos:
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TEMPERATURE=0.6

# --- Google Sheets (leads) vía Apps Script web app - paso 3 --------------
# URL de la implementación del web app (termina en /exec).
LEADS_WEBAPP_URL=
# Misma cadena secreta que pusiste en SECRET dentro de leads_webapp.gs.
LEADS_WEBAPP_SECRET=

# --- Kapso (WhatsApp) - se usa en el paso 4 ------------------------------
# API key del dashboard de Kapso (Project Settings > API Keys).
KAPSO_API_KEY=
# Secreto del webhook (opcional pero recomendado): verifica X-Webhook-Signature.
KAPSO_WEBHOOK_SECRET=
# phone_number_id del número sandbox (fallback; normalmente viene en el payload).
KAPSO_PHONE_NUMBER_ID=
# Overrides (normalmente no hace falta tocarlos):
# KAPSO_BASE_URL=https://api.kapso.ai
# KAPSO_API_VERSION=v24.0

# --- Handoff (a dónde escalar durante desarrollo) ------------------------
# Tu propio email/número - NUNCA un contacto real de DYT (regla del reto).
HANDOFF_CONTACT=

# --- Canal alternativo: Baileys (sidecar Node), opcional -----------------
# URL del cerebro Python (endpoint canal-neutral /message).
PYTHON_BRIDGE_URL=http://127.0.0.1:8099
# Token opcional para autenticar el puente Node -> Python (debe coincidir).
BRIDGE_TOKEN=

# Voice notes - STT (entender los audios): "openai" (Whisper) o "groq" (Whisper,
# free tier). Groq evita el billing de OpenAI para el STT.
STT_PROVIDER=groq
GROQ_API_KEY=
# Si STT_PROVIDER=openai en vez de groq:
OPENAI_API_KEY=
# STT_MODEL=   # default: whisper-large-v3-turbo (groq) / whisper-1 (openai)

# TTS (voz de salida): "elevenlabs" (recomendado, pt-BR mais natural) u "openai".
TTS_PROVIDER=elevenlabs
# ElevenLabs (si TTS_PROVIDER=elevenlabs): key + voice id de tu librería (ideal una voz pt-BR).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI TTS (si TTS_PROVIDER=openai):
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=nova
